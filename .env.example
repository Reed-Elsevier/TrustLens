# Environment variable template for TrustLens.
#
# Setup: copy this file to `.env.local` (git-ignored) and fill in real values.
#   cp .env.example .env.local
# Next.js only reads env files at startup, so restart `npm run dev` (or
# `npm run build`) after creating or changing `.env.local`.
#
# Never commit real secrets. `.env.local` is git-ignored; this file
# (`.env.example`) is the only env file meant to be committed, and must only
# ever contain placeholders.

# ---------------------------------------------------------------------------
# AI (Claude via AWS Bedrock)
# ---------------------------------------------------------------------------

# Bedrock short-term API key, read server-side only by lib/claude.ts
# (getClaudeClient()) and never exposed to the client, in API responses, or
# in logs. Required for the /api/publishing/explain route to call Claude;
# without it (or with an invalid/expired key) that route falls back to a
# deterministic explanation instead of failing.
# Expires within 12 hours, one line, no spaces.
AWS_BEARER_TOKEN_BEDROCK=

# AWS region the Bedrock key above was created in. Required alongside
# AWS_BEARER_TOKEN_BEDROCK by lib/claude.ts (getClaudeClient()) to build the
# Bedrock endpoint URL. Must match the region the key was created in.
AWS_REGION=us-east-1

# Bedrock Claude model ID. Read by lib/claude.ts (getClaudeModel()). Optional
# — defaults to "anthropic.claude-sonnet-5" in code if unset. Must be enabled
# for this model in your AWS account.
CLAUDE_MODEL=anthropic.claude-sonnet-5

# ---------------------------------------------------------------------------
# Scripts
# ---------------------------------------------------------------------------

# Base URL the verification script (scripts/verify-publishing.mjs) sends its
# requests to. Read via process.env.BASE_URL. Optional — defaults to
# http://localhost:3000, which is correct for a local `npm run dev` server.
BASE_URL=http://localhost:3000
